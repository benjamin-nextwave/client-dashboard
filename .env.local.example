# Supabase Configuration
# Copy this file to .env.local and fill in your values

# Project URL - Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon/Public Key - Supabase Dashboard -> Project Settings -> API -> anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key (SECRET - never expose to browser)
# Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Lead Inbox — Make.com webhook voor outbound replies (server-only)
# Dashboard POST't hier de reply-payload heen; Make handelt de
# Instantly-call af. NIET met NEXT_PUBLIC_ prefix — moet niet in browser.
MAKE_OUTBOUND_WEBHOOK_URL=

# Contacten ingest-API — geheime sleutel voor POST /api/contacts.
# Externe software (Clay-kloon) stuurt deze mee als 'Authorization: Bearer <key>'
# om per call één contact aan een klant toe te voegen. Kies een lange,
# willekeurige waarde. Server-only — NIET met NEXT_PUBLIC_ prefix.
CONTACTS_API_KEY=
MAKE_CRM_FEEDBACK_WEBHOOK_URL=

# Rompslomp (boekhouding) — ALLEEN LEZEN.
# Persoonlijk API-token uit Rompslomp: Instellingen -> API-tokens. Geef het
# token bij aanmaken uitsluitend leesrechten op uitgaven; de code doet nooit
# iets anders dan GET, maar het token zelf is de echte grendel.
# Server-only — NIET met NEXT_PUBLIC_ prefix.
ROMPSLOMP_API_TOKEN=

# Het bedrijfsnummer uit de Rompslomp-URL. Leeg laten mag: de koppeling zoekt
# hem dan zelf op via /api/v1/me.
ROMPSLOMP_COMPANY_ID=

# Rompslomp — facturen lezen voor de loopgang.
# Apart token, zodat het token voor uitgaven niet uitgebreid hoeft te worden.
# Geef dit token bij aanmaken UITSLUITEND deze twee rechten:
#   public                  algemene informatie (nodig om het bedrijf te vinden)
#   manage:sales_invoices   uitgaande facturen
# Rompslomp heeft geen alleen-lezen recht op facturen; "manage" is het enige dat
# er is. De code doet nooit iets anders dan GET — zie src/lib/rompslomp/client.ts.
# Geef het GEEN manage:payments: de betaaldatum is toch niet uitleesbaar, en dat
# recht zou wel mogen schrijven.
# Leeg laten mag: dan valt de koppeling terug op ROMPSLOMP_API_TOKEN.
ROMPSLOMP_INVOICES_API_TOKEN=

# Anthropic — de antwoord-assistent in de lead inbox en de hulp-chatbot.
# Sleutel uit console.anthropic.com -> Settings -> API keys. Begint met sk-ant-.
# Server-only — NIET met NEXT_PUBLIC_ prefix, anders staat hij in de browser.
# Leeg laten mag: de assistent meldt dan netjes dat hij niet is ingesteld.
ANTHROPIC_API_KEY=

# Optioneel. Overrulet het model dat de antwoord-assistent gebruikt.
# Leeg laten = claude-sonnet-5.
ASSISTANT_MODEL=
